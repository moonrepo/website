{
  "include": ["src/**/*.ts", "src/**/*.tsx", "tsdown.config.ts"],
  "compilerOptions": {
    "composite": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": ".tsbuild",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  }
}
